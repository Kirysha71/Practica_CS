<Window x:Class="GradeJournal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный журнал преподавателя" Height="500" Width="800">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddGradeCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditGradeCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteGradeCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Студенты">
                <MenuItem Header="_Добавить студента" Command="{Binding AddGradeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Оценки">
                <MenuItem Header="_Добавить оценку" Command="{Binding AddGradeCommand}"/>
                <MenuItem Header="_Редактировать оценку" Command="{Binding EditGradeCommand}"/>
                <MenuItem Header="_Удалить оценку" Command="{Binding DeleteGradeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Настройки">
                <MenuItem Header="_Параметры" Click="Settings_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Button Content="Добавить оценку" Command="{Binding AddGradeCommand}" 
                        ToolTip="Ctrl+N"/>
                <Separator/>
                <Button Content="Редактировать оценку" Command="{Binding EditGradeCommand}" 
                        ToolTip="Ctrl+E"/>
                <Separator/>
                <Button Content="Удалить оценку" Command="{Binding DeleteGradeCommand}" 
                        ToolTip="Del"/>
            </ToolBar>
        </ToolBarTray>

        <DataGrid Grid.Row="2" x:Name="dgGrades" AutoGenerateColumns="False" 
                  CanUserAddRows="False" Margin="5" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="*"/>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="*"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding Value}" Width="75"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
