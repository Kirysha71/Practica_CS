<Window x:Class="GradeJournal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный журнал преподавателя" Height="600" Width="1000">

    <Window.Resources>
        <DataTemplate x:Key="StudentTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10" 
                    Background="White" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Средний балл:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AverageGrade, StringFormat={}{0:F2}}" 
                                   FontSize="16" Foreground="DarkGreen"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0">
                        <TextBlock Text="Оценки:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding Grades}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Subject}" Width="100"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="40" Margin="5,0" 
                                                 TextAlignment="Center"/>
                                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="150" Margin="5,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Посещаемость:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding Attendance}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM}}" 
                                                   Width="40"/>
                                        <CheckBox IsChecked="{Binding IsPresent, UpdateSourceTrigger=PropertyChanged}" 
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <ControlTemplate x:Key="ExportButtonTemplate" TargetType="Button">
            <Grid>
                <Border x:Name="Border" Background="#4CAF50" CornerRadius="5" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19,9h-4V3H9v6H5l7,7L19,9z M5,18v2h14v-2H5z" 
                      Fill="White" Width="20" Height="20" Margin="0,0,10,0"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#45a049"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3d8b40"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddStudentCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditStudentCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteStudentCommand}"/>
    </Window.InputBindings>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Экспорт в Excel" Command="{Binding ExportCommand}"/>
                <Separator/>
                <MenuItem Header="_Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Студенты">
                <MenuItem Header="_Добавить студента" Command="{Binding AddStudentCommand}"/>
                <MenuItem Header="_Редактировать" Command="{Binding EditStudentCommand}"/>
                <MenuItem Header="_Удалить" Command="{Binding DeleteStudentCommand}"/>
            </MenuItem>
            <MenuItem Header="_Оценки">
                <MenuItem Header="_Добавить оценку" Command="{Binding AddGradeCommand}"/>
                <MenuItem Header="_Редактировать оценку" Command="{Binding EditGradeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Настройки">
                <MenuItem Header="_Параметры" Click="Settings_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.Row="1" Margin="0,10,0,10">
            <ToolBar>
                <Button Content="Добавить студента" Command="{Binding AddStudentCommand}" 
                        ToolTip="Ctrl+N"/>
                <Separator/>
                <Button Content="Редактировать" Command="{Binding EditStudentCommand}" 
                        ToolTip="Ctrl+E"/>
                <Separator/>
                <Button Content="Удалить" Command="{Binding DeleteStudentCommand}" 
                        ToolTip="Del"/>
                <Separator/>
                <Button Content="Добавить оценку" Command="{Binding AddGradeCommand}"/>
                <Separator/>
                <Button Content="Экспорт в Excel" Command="{Binding ExportCommand}" 
                        Template="{StaticResource ExportButtonTemplate}"
                        ToolTip="Экспортировать данные в Excel"/>
            </ToolBar>
        </ToolBarTray>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Всего студентов: " FontWeight="Bold"/>
            <TextBlock Text="{Binding Students.Count}" Margin="0,0,20,0"/>
            <TextBlock Text="Средний балл по группе: " FontWeight="Bold"/>
            <TextBlock Text="{Binding GroupAverage, StringFormat={}{0:F2}}" 
                       Foreground="DarkBlue" FontWeight="Bold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Students}" 
                          ItemTemplate="{StaticResource StudentTemplate}"/>
        </ScrollViewer>
    </Grid>
</Window>