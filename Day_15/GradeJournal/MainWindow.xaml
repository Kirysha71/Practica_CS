<Window x:Class="GradeJournal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал преподавателя" Height="600" Width="800">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddStudentCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding AddGradeCommand}"/>
        <KeyBinding Gesture="Del" Command="{Binding DeleteStudentCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
              Panel.ZIndex="100" Background="#80FFFFFF">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <TextBlock Text="Загрузка данных..." FontSize="18" HorizontalAlignment="Center" 
                           Margin="0,0,0,20" FontWeight="Bold"/>
                <ProgressBar Height="30" Value="{Binding ProgressValue}" Maximum="100" 
                             Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:F0}%}" 
                           HorizontalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Grid>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Menu Grid.Row="0">
                <MenuItem Header="Файл">
                    <MenuItem Header="Загрузить" Command="{Binding LoadCommand}"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="Студенты">
                    <MenuItem Header="Добавить" Command="{Binding AddStudentCommand}"/>
                    <MenuItem Header="Удалить" Command="{Binding DeleteStudentCommand}"/>
                </MenuItem>
                <MenuItem Header="Оценки">
                    <MenuItem Header="Добавить оценку" Command="{Binding AddGradeCommand}"/>
                </MenuItem>
                <MenuItem Header="Настройки">
                    <MenuItem Header="Параметры"/>
                </MenuItem>
            </Menu>

            <ToolBarTray Grid.Row="1">
                <ToolBar>
                    <Button Content="Загрузить" Command="{Binding LoadCommand}" Margin="2"/>
                    <Separator/>
                    <Button Content="Добавить студента" Command="{Binding AddStudentCommand}" Margin="2"/>
                    <Separator/>
                    <Button Content="Удалить студента" Command="{Binding DeleteStudentCommand}" Margin="2" 
                            Background="#FFE0E0"/>
                    <Separator/>
                    <Button Content="Добавить оценку" Command="{Binding AddGradeCommand}" Margin="2"/>
                    <Separator/>
                    <Button Command="{Binding ExportCommand}" Margin="5,0" Padding="10,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬇" Margin="0,0,5,0" FontWeight="Bold"/>
                            <TextBlock Text="Экспорт"/>
                        </StackPanel>
                    </Button>
                </ToolBar>
            </ToolBarTray>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,5">
                <TextBlock Text="Всего студентов: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Students.Count}" Margin="0,0,20,0"/>
                <TextBlock Text="Средний балл по группе: " FontWeight="Bold"/>
                <TextBlock Text="{Binding GroupAverage, StringFormat={}{0:F2}}" 
                           Foreground="Blue" FontWeight="Bold"/>
            </StackPanel>

            <ListBox Grid.Row="3" ItemsSource="{Binding Students}" 
                     SelectedItem="{Binding SelectedStudent}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="15" 
                                CornerRadius="4" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="16" 
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="Средний балл:" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding AverageGrade, StringFormat={}{0:F2}}" 
                                               Foreground="Green" FontWeight="Bold" FontSize="18"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="Оценки:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Grades}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="{Binding Subject}" Width="120" 
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                             Width="40" Margin="5,0" TextAlignment="Center"/>
                                                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" 
                                                             Width="200" Margin="5,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Посещаемость:" FontWeight="Bold" FontSize="14" 
                                               Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Attendance}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="{Binding Date, StringFormat=dd.MM}" 
                                                               Width="40"/>
                                                    <CheckBox IsChecked="{Binding IsPresent}" 
                                                              VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>