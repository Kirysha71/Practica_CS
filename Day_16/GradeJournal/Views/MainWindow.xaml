<Window x:Class="GradeJournal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный журнал" Height="600" Width="1050" >

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddCommand}"/>
        <KeyBinding Gesture="F2" Command="{Binding EditCommand}"/>
        <KeyBinding Gesture="Del" Command="{Binding DeleteCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Rectangle Fill="White" Opacity="0.8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="11">
            <TextBlock Text="Загрузка данных..." FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <ProgressBar Width="400" Height="25" Value="{Binding Progress}" Margin="0,10"/>
            <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}" FontSize="16" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Menu Grid.Row="0" FontSize="14">
                <MenuItem Header="Файл">
                    <MenuItem Header="Загрузить" Command="{Binding LoadCommand}" InputGestureText="Ctrl+L"/>
                    <MenuItem Header="Сохранить" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                    <Separator/>
                    <MenuItem Header="Выход"/>
                </MenuItem>
                <MenuItem Header="Студенты">
                    <MenuItem Header="Добавить" Command="{Binding AddCommand}" InputGestureText="Ctrl+N"/>
                    <MenuItem Header="Редактировать" Command="{Binding EditCommand}" InputGestureText="F2"/>
                    <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                </MenuItem>
                <MenuItem Header="Сервис">
                    <MenuItem Header="Отправить уведомление" Command="{Binding NotifyCommand}"/>
                </MenuItem>
            </Menu>

            <ToolBarTray Grid.Row="1" Margin="0,10,0,10">
                <ToolBar>
                    <Button Content="📥 Загрузить" Command="{Binding LoadCommand}" Padding="10,5" Margin="2"/>
                    <Button Content="💾 Сохранить" Command="{Binding SaveCommand}" Padding="10,5" Margin="2"/>
                    <Separator/>
                    <Button Content="➕ Добавить" Command="{Binding AddCommand}" Padding="10,5" Margin="2"/>
                    <Button Content="️ Редактировать" Command="{Binding EditCommand}" Padding="10,5" Margin="2"/>
                    <Button Content="🗑️ Удалить" Command="{Binding DeleteCommand}" Padding="10,5" Margin="2" Background="#FFCCCC"/>
                    <Separator/>
                    <Button Content=" Уведомить" Command="{Binding NotifyCommand}" Padding="10,5" Margin="2" Background="#CCFFCC"/>
                </ToolBar>
            </ToolBarTray>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Всего студентов: " FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="{Binding Students.Count}" FontSize="14" Margin="0,0,30,0"/>
                <TextBlock Text="Средний балл по группе: " FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="{Binding GroupAverage}" FontSize="14" Foreground="Blue" FontWeight="Bold"/>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" 
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="5" Padding="20" 
                                    CornerRadius="8" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="16" 
                                                   Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="Средний балл:" FontSize="12" Margin="0,0,0,5" Foreground="#666"/>
                                        <TextBlock Text="{Binding AverageGrade, StringFormat={}{0:F2}}" 
                                                   Foreground="Green" FontWeight="Bold" FontSize="20"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                        <TextBlock Text="Оценки:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Grades}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                                        <TextBlock Text="{Binding Subject}" Width="150" 
                                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding Value}" Width="40" TextAlignment="Center" 
                                                                 Margin="5,0" FontSize="14"/>
                                                        <TextBox Text="{Binding Comment}" Width="250" Margin="5,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Посещаемость:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Attendance}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                                        <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}" 
                                                                   Width="80" VerticalAlignment="Center"/>
                                                        <CheckBox IsChecked="{Binding IsPresent}" 
                                                                  VerticalAlignment="Center" Margin="5,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>