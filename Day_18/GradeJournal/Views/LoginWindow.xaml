<Window x:Class="GradeJournal.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="128*"/>
            <RowDefinition Height="Auto" MinHeight="50.62"/>
            <RowDefinition Height="53*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Электронный журнал" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,30" Width="258"/>

        <TextBox Grid.Row="1" x:Name="TxtLogin" Margin="0,0,0,72" Padding="8" FontSize="14" Grid.RowSpan="2" TextChanged="TxtLogin_TextChanged">
            <TextBox.Text>
                <Binding Path="Username" UpdateSourceTrigger="PropertyChanged"/>
            </TextBox.Text>
        </TextBox>

        <PasswordBox Grid.Row="2" x:Name="TxtPass" Margin="0,73,0,0" Padding="8" 
                     FontSize="14" PasswordChanged="TxtPass_PasswordChanged"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,12" Width="309">
            <Button Content="Войти" Width="120" Padding="10,5" FontSize="14"
                    Command="{Binding LoginCommand}"
                    Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}" Margin="0,0,30,0"/>
            <Button Content="Зарегистрироваться" Width="159" Padding="10,5" FontSize="14"
                    Command="{Binding RegisterCommand}"
                    Visibility="{Binding IsLoginMode, ConverterParameter=Invert, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</Window>