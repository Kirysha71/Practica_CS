@model EveningMovies.Models.EveningMovie

<!DOCTYPE html>
<html>
<head>
    <title>Предложить фильм</title>
    <style>
        body { font-family: Arial; margin: 20px; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input, select { width: 300px; padding: 5px; }
        .btn { padding: 5px 10px; background: #007bff; color: white; border: none; cursor: pointer; }
    </style>
</head>
<body>
    <h1>Предложить фильм</h1>
    
    <form method="post" action="/Evening/Suggest">
        <div class="form-group">
            <label>Название фильма</label>
            <input name="Title" required />
        </div>
        
        <div class="form-group">
            <label>Жанр</label>
            <select name="Genre" required>
                <option value="">Выберите</option>
                <option>Драма</option>
                <option>Комедия</option>
                <option>Фантастика</option>
                <option>Криминал</option>
                <option>Мелодрама</option>
            </select>
        </div>
        
        <div class="form-group">
            <label>Настроение</label>
            <select name="MoodTag" required>
                <option value="">Выберите</option>
                <option>Веселое</option>
                <option>Грустное</option>
                <option>Страшное</option>
                <option>Романтичное</option>
                <option>Спокойное</option>
            </select>
        </div>
        
        <div class="form-group">
            <label>Кто добавляет</label>
            <input name="AddedBy" required />
        </div>
        
        <button type="submit" class="btn">Отправить</button>
        <a href="/Evening/Index">Отмена</a>
    </form>
</body>
</html>